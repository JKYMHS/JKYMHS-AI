# 어디갈래 AI 서버 설정 (TRD 11장). `.env`로 복사해서 씁니다.
# 비밀값은 저장소에 넣지 않습니다.

# 인증·비밀값
AI_API_KEY=
GEMINI_API_KEY=

# Gemini 모델
GEMINI_COMPOSE_MODEL=gemini-2.5-flash
GEMINI_BATCH_MODEL=gemini-2.5-flash
# 확인 필요 (개인화·재정렬을 쓸 때만)
GEMINI_EMBED_MODEL=

# 코스 구성
COMPOSE_DEADLINE_SEC=18
COMPOSE_CALL_TIMEOUT_SEC=12
COMPOSE_THINKING_BUDGET=0
COMPOSE_MAX_OUTPUT_TOKENS=1024
LLM_CONCURRENCY=24
COURSE_OVERLAP_MAX=0.5
REASON_MAX_CHARS=40
# 최신 검증 버전 (프롬프트 작업에서 정함)
PROMPT_COMPOSE_VERSION=

# 운영
UVICORN_WORKERS=2
# 팀 결정
GEMINI_MONTHLY_BUDGET_USD=
LOG_LEVEL=INFO

# DB (AI 전용 계정)
AI_DB_HOST=localhost
AI_DB_PORT=3306
AI_DB_USER=
AI_DB_PASSWORD=
AI_DB_NAME=ai
JKYMHS_DB_NAME=jkymhs
